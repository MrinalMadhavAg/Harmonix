# Copy to .env to override defaults. docker-compose.yml already sets sane
# values for the containerised stack; this file is for running the backend
# directly against a local PostgreSQL.

DATABASE_URL=postgresql://harmonix:harmonix@localhost:5433/harmonix

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Confidence at or above which two records may be linked without a human.
# Precision is held by the safety layer, not by this number; what it trades is
# recall against review-queue volume. See app/config.py.
MATCH_THRESHOLD=0.58

# Below this a pair is not worth a reviewer's time.
REVIEW_FLOOR=0.42

# Retrieval depth per channel (BM25 and FAISS each return this many).
CANDIDATE_K=30

# Seed the synthetic catalogue when the database is empty on startup.
AUTO_SEED=true

# FAISS/BM25 indexes are per-process memory. Keep this at 1.
UVICORN_WORKERS=1

LOG_LEVEL=info
